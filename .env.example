# Copy to .env and fill in. Never commit .env.

# Which LLM to use: "gemini" (Gemini first, Ollama fallback) or "ollama" (Ollama only)
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.2

# Gemini (not needed when LLM_PROVIDER=ollama)
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=your-stable-flash-model-id

# Ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
# Only for a remote/cloud Ollama host that requires auth; leave empty for local Ollama
OLLAMA_API_KEY=
# Context window (tokens); Ollama's default is too small for BRD + memory prompts
OLLAMA_NUM_CTX=16384

CHROMA_PATH=memory/chroma
OUTPUT_DIR=outputs
CACHE_DIR=.cache
